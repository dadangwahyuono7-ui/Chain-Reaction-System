# ── Copy file ini jadi .env.local dan isi nilai-nilainya ─────────────────────

# ── Model A: Local Qwen3-8B (gratis, offline) ────────────────────────────────
LLM_PROVIDER=openai-compatible
LLM_API_KEY=local
LLM_BASE_URL=http://localhost:8080/v1
LLM_MODEL=qwen3-8b-q4.gguf

# ── Model B: Bluepack Claude API (online) ─────────────────────────────────────
BLUEPACK_API_KEY=your_bluepack_api_key_here
BLUEPACK_BASE_URL=https://ai.bluepack.my.id/v1
BLUEPACK_MODEL=claude-3-5-haiku-20241022

# ── Auth ──────────────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=ganti_ini_dengan_random_string_panjang
BETTER_AUTH_URL=http://localhost:3002

# ── Database (SQLite lokal) ───────────────────────────────────────────────────
DATABASE_URL=./sultan.db

# ── FRED API (10Y TIPS yield) — daftar gratis di fred.stlouisfed.org ─────────
FRED_API_KEY=your_fred_api_key_here

# ── Telegram Alert (notifikasi HP saat CF/VR fire) ───────────────────────────
# 1. Buat bot di @BotFather → /newbot → copy token
# 2. Chat ke bot kamu, lalu GET https://api.telegram.org/bot<TOKEN>/getUpdates
#    → ambil "id" dari result[0].message.chat.id
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
